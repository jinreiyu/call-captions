#!/bin/bash
# call-captions: live Japanese -> English captions for calls, on-device on Apple Silicon Macs.
#
# Homebrew installs this into its own folder, and `brew install` runs `call-captions install-env`
# to put Python, the packages and the models in that same folder, so `brew uninstall` removes
# all of them. Only your settings (~/call-captions/options.txt) and the Applications app live
# outside it; `call-captions uninstall` removes those too. BlackHole is never installed or
# removed without asking.
set -euo pipefail

VERSION="1.1.0"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
settings="${CALL_CAPTIONS_HOME:-$HOME/call-captions}"
py="$here/venv/bin/python"
# Homebrew installs this at <brew prefix>/Cellar/call-captions/<version>/libexec/bin.
brew_prefix="${HOMEBREW_PREFIX:-$(cd "$here/../../../.." 2>/dev/null && pwd)}"
[[ -x "$brew_prefix/bin/brew" ]] || brew_prefix=/opt/homebrew
bundle_id="local.callcaptions.launcher"
export PATH="$brew_prefix/bin:$PATH"
export HF_HOME="$here/hf" HF_HUB_DISABLE_TELEMETRY=1

usage() {
  cat <<EOF
call-captions $VERSION: live Japanese -> English captions for calls, on your Mac.

  call-captions                  caption what plays into BlackHole (the call)
  call-captions --file AUDIO     caption an audio file instead, to test
  call-captions setup            check everything and fix what's missing
  call-captions app              rebuild "Call Captions.app" in Applications
  call-captions uninstall        remove everything (BlackHole is left alone)
  call-captions help             this text plus every caption option

Settings used by the app: $settings/options.txt
EOF
}

interactive() { [[ -t 0 && -t 1 ]]; }

ask() { # ask "question" default(Y|N) -> 0 for yes
  local answer=""
  if [[ "$2" == Y ]]; then
    read -r -p "$1 [Y/n] " answer || true
    [[ -z "$answer" || "$answer" == [yY]* ]]
  else
    read -r -p "$1 [y/N] " answer || true
    [[ "$answer" == [yY]* ]]
  fi
}

blackholes() {
  local d
  for d in /Library/Audio/Plug-Ins/HAL/BlackHole*.driver; do
    [[ -e "$d" ]] && basename "$d" .driver
  done
  return 0
}

# Run by `brew install` / `brew upgrade` / `brew postinstall` inside Homebrew's sandbox: it may
# write only inside Homebrew's folders and can't read your home folder.
install_env() {
  export UV_NO_CONFIG=1 UV_PYTHON_INSTALL_DIR="$here/python"
  export UV_CACHE_DIR="${HOMEBREW_CACHE:-$here}/call-captions-uv-cache"

  # Upgrades and reinstalls get a new folder; bring the 2 GB of models along instead of
  # downloading them again. (The old folder is deleted by Homebrew afterwards.)
  if [[ ! -d "$here/hf/hub" ]]; then
    local old
    for old in "$here"/../../*/libexec/hf; do
      [[ -d "$old/hub" && "$(cd "$old" && pwd)" != "$here/hf" ]] || continue
      echo "==> Reusing the models from the previous version"
      rm -rf "$here/hf"
      mv "$old" "$here/hf"
      break
    done
  fi

  echo "==> Python 3.12"
  [[ -x "$py" ]] || uv venv --quiet --python 3.12 --python-preference only-managed "$here/venv"
  echo "==> Python packages"
  uv pip install --quiet --python "$py" -r "$here/requirements.txt"
  echo "==> Speech and translation models (about 2 GB the first time)"
  "$py" "$here/live_captions.py" --download-only
}

build_app() {
  local apps app cli
  if [[ -w /Applications ]]; then apps=/Applications; else apps="$HOME/Applications"; fi
  mkdir -p "$apps"
  app="$apps/Call Captions.app"
  cli="$brew_prefix/bin/call-captions" # stable across upgrades, unlike this version's folder
  [[ -x "$cli" ]] || cli="$here/bin/call-captions"

  local launcher
  launcher="$(sed -e "s|__CLI__|$cli|" -e "s|__SETTINGS__|$settings|" "$here/app/launcher.sh")"
  # Already current: leave it alone so macOS keeps its permissions for the app.
  if [[ "${1:-}" != --force && -f "$app/Contents/MacOS/CallCaptions" ]] &&
    [[ "$(cat "$app/Contents/MacOS/CallCaptions")" == "$launcher" ]] &&
    cmp -s "$here/app/Info.plist" "$app/Contents/Info.plist"; then
    return 0
  fi

  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$here/app/Info.plist" "$app/Contents/Info.plist"
  cp "$here/app/AppIcon.icns" "$app/Contents/Resources/AppIcon.icns"
  printf '%s\n' "$launcher" >"$app/Contents/MacOS/CallCaptions"
  chmod 755 "$app/Contents/MacOS/CallCaptions"
  mkdir -p "$settings"
  echo "$app" >"$settings/.app-path"
  local lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  if [[ -x "$lsregister" ]]; then "$lsregister" -f "$app" || true; fi
  echo "==> Added \"Call Captions\" to $apps"
}

ensure_settings() {
  mkdir -p "$settings"
  [[ -f "$settings/options.txt" ]] && return 0
  local first
  first="$(blackholes | head -n 1)"
  {
    echo "# Options the Call Captions app uses, the same flags as \`call-captions help\` lists."
    echo "# Lines starting with # are ignored."
    if [[ -n "$first" ]]; then
      echo "--device \"${first/BlackHole/BlackHole }\""
    else
      echo "# --device \"BlackHole 2ch\""
    fi
    echo "# --hint \"株式会社サンプル 山田\""
    echo "# --english-only"
  } >"$settings/options.txt"
}

# The earlier script-based install kept Python and the models in ~/call-captions. Homebrew has
# its own copies now, so offer to free that space. options.txt is kept.
tidy_old_install() {
  local old=() f
  for f in .venv .uv .hf dist app live_captions.py requirements.txt run.sh install.sh uninstall.sh \
           make-app.sh README.md .brew-formulae .brew-casks .homebrew-installed-by-us .requirements.sha256; do
    [[ -e "$settings/$f" ]] && old+=("$settings/$f")
  done
  ((${#old[@]})) || return 0
  interactive || return 0
  local size
  size="$(du -sch "${old[@]}" 2>/dev/null | tail -n 1 | cut -f1)"
  echo "The earlier Call Captions install left Python and models in $settings ($size)."
  if ask "Delete them? Your options.txt is kept." Y; then
    if grep -qx gh "$settings/.brew-formulae" 2>/dev/null; then
      echo "    The earlier installer also added the GitHub CLI. If you don't use it: brew uninstall gh"
    fi
    rm -rf "${old[@]}"
    echo "    Freed $size."
  fi
}

ensure_blackhole() {
  [[ -n "$(blackholes)" ]] && return 0
  echo "No BlackHole audio driver found. Call audio reaches the captioner through one."
  if interactive && ask "Install BlackHole 2ch now with Homebrew? (asks for your Mac password)" Y; then
    brew install --cask blackhole-2ch
    echo "If BlackHole doesn't appear in Audio MIDI Setup, restart the Mac."
  else
    echo "Install it later with: brew install --cask blackhole-2ch"
  fi
}

require_env() {
  [[ -x "$py" ]] && return 0
  echo "The Python environment is missing. Rebuild it with:" >&2
  echo "  brew postinstall jinreiyu/tap/call-captions" >&2
  exit 1
}

first_run() {
  require_env
  ensure_settings
  build_app
  tidy_old_install
  ensure_blackhole
}

setup() {
  [[ -x "$py" ]] || install_env
  first_run
  echo
  echo "Ready. Double-click \"Call Captions\" in Applications, or run: call-captions"
  echo "Settings: $settings/options.txt"
}

uninstall() {
  echo "This removes the Call Captions app, your settings ($settings) and, through"
  echo "Homebrew, the program with its Python and models. BlackHole is left alone."
  ask "Continue?" N || { echo "Cancelled."; exit 0; }
  local app
  for app in "$(cat "$settings/.app-path" 2>/dev/null || true)" "/Applications/Call Captions.app" \
             "$HOME/Applications/Call Captions.app"; do
    [[ "$app" == */"Call Captions.app" && -d "$app" ]] || continue
    # Only remove an app this tool made.
    if grep -q "$bundle_id" "$app/Contents/Info.plist" 2>/dev/null; then
      rm -rf "$app" && echo "Removed $app"
    fi
  done
  tccutil reset AppleEvents "$bundle_id" &>/dev/null || true
  if [[ -d "$settings" && "$settings" != "/" && "$settings" != "$HOME" ]]; then
    rm -rf "$settings" && echo "Removed $settings"
  fi
  echo "Removing the program, Python and models:"
  if ! brew uninstall call-captions; then
    echo "Homebrew couldn't finish. Run this to remove the rest: brew uninstall call-captions" >&2
    exit 1
  fi
  cat <<'EOF'

Done. Left alone on purpose: BlackHole and the Multi-Output Device in Audio MIDI Setup.
EOF
}

case "${1:-}" in
  install-env) install_env ;;
  setup) setup ;;
  app) require_env; build_app --force ;;
  uninstall) uninstall ;;
  version | --version) echo "call-captions $VERSION" ;;
  help | -h | --help)
    usage
    if [[ -x "$py" ]]; then echo; "$py" "$here/live_captions.py" --help; fi
    ;;
  *)
    first_run
    exec "$py" "$here/live_captions.py" "$@"
    ;;
esac
